# =============================================
# TerraLegalAI — Environment Variables
# Copy file này thành .env và điền giá trị thực
# =============================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=2048

# --- Qdrant (Docker local) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=land_law_chunks

# --- Embedding Model (local, offline) ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16

# --- Reranker Model ---
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=3

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=terralegal
POSTGRES_USER=terralegal_user
POSTGRES_PASSWORD=your-strong-password-here
DATABASE_URL=postgresql+asyncpg://terralegal_user:your-strong-password-here@localhost:5432/terralegal

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-random-secret-key-here
CORS_ORIGINS=["http://localhost:3000"]

# --- RAG Settings ---
RETRIEVAL_TOP_K=10
CHUNK_SIZE=500
CHUNK_OVERLAP=80
SIMILARITY_THRESHOLD=0.65

# --- Langfuse (Observability) — optional ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
